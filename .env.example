# ---------------------------------------------------------------
# Lora Fashions — local environment template
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Every value below is a FAKE, local-only value. Never put real
# credentials in this file. Your real .env is git-ignored.
# Application variables (APP_*) are added by the parts that need them.
# ---------------------------------------------------------------

# --- PostgreSQL 17 ---------------------------------------------
LOCAL_POSTGRES_DB=lora
LOCAL_POSTGRES_USER=lora
LOCAL_POSTGRES_PASSWORD=change-me-local-only
LOCAL_POSTGRES_PORT=5432

# --- MongoDB 8 -------------------------------------------------
LOCAL_MONGO_DB=lora
LOCAL_MONGO_ROOT_USER=lora
LOCAL_MONGO_ROOT_PASSWORD=change-me-local-only
LOCAL_MONGO_PORT=27017

# --- Object storage (SeaweedFS S3 gateway, see ADR-0002) -------
LOCAL_S3_ACCESS_KEY=lora-local-access
LOCAL_S3_SECRET_KEY=change-me-local-only
LOCAL_S3_BUCKET=lora-local
LOCAL_S3_REGION=us-east-1
LOCAL_S3_PORT=8333

# --- Mailpit (local email catcher) -----------------------------
LOCAL_MAILPIT_SMTP_PORT=1025
LOCAL_MAILPIT_UI_PORT=8025
