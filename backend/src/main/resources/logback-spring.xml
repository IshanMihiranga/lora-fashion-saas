<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging (CLAUDE.md §10, §18):
  - dev / prod: one JSON object per line (logstash-logback-encoder), MDC included (requestId).
  - every other profile (local, tests): readable console lines that show the request ID.
  Never log passwords, tokens, secrets, full addresses or card data.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProfile name="dev | prod">
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <timeZone>UTC</timeZone>
        <fieldNames>
          <levelValue>[ignore]</levelValue>
          <version>[ignore]</version>
        </fieldNames>
        <customFields>{"service":"lora-fashion-backend"}</customFields>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="JSON_CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="!(dev | prod)">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC} %5p [%15.15t] [%X{requestId:--}] %-40.40logger{39} : %m%n%wEx</pattern>
        <charset>UTF-8</charset>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>
</configuration>
